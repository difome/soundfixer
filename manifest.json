{
  "manifest_version": 3,
  "name": "SoundFixer for Chrome & Edge",
  "author": "difome (Chrome port) • Original by Val Packett",
  "version": "2.0.0",
  "description": "Fix annoying sound problems in YouTube videos: audio in one channel only, too quiet or too loud",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "SoundFixer for Chrome & Edge",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
